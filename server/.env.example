# Server Environment Configuration
PORT=5001
NODE_ENV=development

# Database Connection Strings (Neon PostgreSQL)
# Pooled connection string (used for normal database queries)
DATABASE_URL="postgresql://user:password@ep-xyz-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Direct connection string (used for Prisma migrations)
DIRECT_URL="postgresql://user:password@ep-xyz.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Authentication Configuration
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
JWT_SECRET="your-256-bit-secret-here"
JWT_EXPIRES_IN="7d"
